{
  "name": "squares-app",
  "version": "1.0.0",
  "description": "Interactive football squares web app with multi-room support, admin console, and per-room multi-board management",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite",
    "check:keys": "node scripts/check-storage-keys.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:async": "node scripts/check-async.mjs",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" \"scripts/*.mjs\"",
    "check:theme": "node scripts/check-theme.mjs",
    "check:pools": "node scripts/check-pools.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "check:notify": "node scripts/check-notify.mjs",
    "check:hooks": "node scripts/check-hooks.mjs",
    "check:api": "node scripts/check-api.mjs",
    "check:payments": "node scripts/check-payment-links.mjs",
    "check:scores": "node scripts/check-scores.mjs",
    "check:smartfill": "node scripts/check-smartfill.mjs",
    "check:pickem": "node scripts/check-pickem.mjs",
    "check:deletion": "node scripts/check-deletion.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.5",
    "@vercel/og": "^1.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "prettier": "^3.9.6",
    "vite": "^5.0.8"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
